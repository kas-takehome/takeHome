{
  "name": "dispute-triage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "express": "5.1.0",
    "express-rate-limit": "8.7.0",
    "helmet": "8.1.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@tailwindcss/vite": "4.1.11",
    "@testing-library/react": "16.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.3",
    "@types/node": "22.16.5",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.9",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.0",
    "eslint": "9.30.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "supertest": "7.1.4",
    "tailwindcss": "4.1.11",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.37.0",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
